# Server
PORT=3000

# Oxford Dictionaries API (https://developer.oxforddictionaries.com/)
# Register for a free account to get these. If left blank, Duordle falls
# back to its local curated word lists automatically (the game still
# works fully without these keys).
OXFORD_APP_ID=
OXFORD_APP_KEY=

# Optional: set to true to ask Oxford about EVERY new guess (slower, uses more of your
# API quota). Default (false): words found in the bundled dictionary are accepted
# instantly and Oxford is only asked about words the dictionary does not know.
OXFORD_CHECK_ALL=false
